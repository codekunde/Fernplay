<local:SkinWindow x:Class="Fernplay.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay library" ShowInTaskbar="False">
    <local:SkinWindow.Resources>
        <!-- Lists in the library: LCD well, green text, the selected row in dark green, a header row of small caps. -->
        <Style x:Key="LibHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{StaticResource FrameDark}" BorderBrush="{StaticResource Shadow}" BorderThickness="0,0,0.5,0.5" Padding="2,0.5,2,0.5">
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource SkinLabel}" Foreground="{StaticResource SkinText}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="2" Margin="0,0,-1,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibRow" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource LcdGreen}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="Transparent" Padding="0,0.5">
                            <local:TightRowPresenter TextBlock.FontFamily="{StaticResource SkinFont}" TextBlock.FontSize="7" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1D4A26" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:FocusRing.Visible" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#6FAE62" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="0.5" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibList" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LibRow}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <DockPanel>
                            <GridViewHeaderRowPresenter DockPanel.Dock="Top" Columns="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                        ColumnHeaderContainerStyle="{StaticResource LibHeader}" />
                            <ScrollViewer x:Name="Scroller" Style="{StaticResource SkinScrollViewer}" Focusable="False" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The navigation list: headings (not selectable) and indented views. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="2,0.5">
                            <TextBlock x:Name="Label" Text="{Binding Text}" Margin="{Binding Indent}" Style="{StaticResource LcdText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource SkinText}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1D4A26" />
                                <Setter TargetName="Label" Property="Foreground" Value="#F2F4F8" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:FocusRing.Visible" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#6FAE62" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="0.5" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibSearch" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource LcdGreen}" />
            <Setter Property="CaretBrush" Value="{StaticResource LcdGreen}" />
            <Setter Property="SelectionBrush" Value="#2FB845" />
            <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
            <Setter Property="FontSize" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Style="{StaticResource Inset}" Padding="2,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:SkinWindow.Resources>

    <!-- Skin pixels, scaled by SkinWindow.Scale; the size changes with the corner grip and is remembered. -->
    <Border x:Name="Root" Width="460" Height="270" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Background="{StaticResource TitleRibs}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY LIBRARY" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button Style="{StaticResource TitleButton}" Content="x" Click="Close_Click"
                            ToolTip="Hide the library (Alt+L)" AutomationProperties.Name="Hide the library" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="4,3,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Inset}">
                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Library views">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Style="{StaticResource SkinScrollViewer}" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                    </ListBox>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="11" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="68" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SEARCH" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource LibSearch}" TextChanged="Search_TextChanged"
                                 AutomationProperties.Name="Search the library" ToolTip="Artist, album, title, genre or year: every word must match" />
                        <Button Grid.Column="2" Style="{StaticResource SkinButton}" Content="CLEAR SEARCH" Height="10" Padding="4,0" Margin="3,0,0,0"
                                Click="ClearSearch_Click" AutomationProperties.Name="Clear the search" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Inset}">
                            <ListView x:Name="ArtistList" Style="{StaticResource LibList}" SelectionMode="Single" SelectionChanged="Artist_SelectionChanged"
                                      MouseDoubleClick="Artist_DoubleClick" AutomationProperties.Name="Artists">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ARTIST" Width="92" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="ALBUMS" Width="30" DisplayMemberBinding="{Binding Albums}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Inset}">
                            <ListView x:Name="AlbumList" Style="{StaticResource LibList}" SelectionMode="Single" SelectionChanged="Album_SelectionChanged"
                                      MouseDoubleClick="Album_DoubleClick" AutomationProperties.Name="Albums">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ALBUM" Width="70" DisplayMemberBinding="{Binding Album}" />
                                        <GridViewColumn Header="ARTIST" Width="52" DisplayMemberBinding="{Binding Artist}" />
                                        <GridViewColumn Header="TRACKS" Width="30" DisplayMemberBinding="{Binding Tracks}" />
                                        <GridViewColumn Header="YEAR" Width="22" DisplayMemberBinding="{Binding Year}" />
                                        <GridViewColumn Header="GENRE" Width="34" DisplayMemberBinding="{Binding Genre}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{StaticResource Inset}">
                        <Grid>
                            <ListView x:Name="TrackList" Style="{StaticResource LibList}" SelectionMode="Extended"
                                      MouseDoubleClick="Track_DoubleClick" KeyDown="Track_KeyDown"
                                      PreviewMouseLeftButtonDown="Track_PreviewMouseDown" PreviewMouseMove="Track_PreviewMouseMove"
                                      AutomationProperties.Name="Tracks"
                                      AutomationProperties.HelpText="Enter or double-click plays; drag tracks to the playlist to add them">
                                <ListView.View>
                                    <GridView x:Name="TrackColumns" />
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource LcdText}" Foreground="#2E8A43" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="20,0" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="4,3,4,2" Height="10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SkinButton}" Content="PLAY" Width="26" Click="Play_Click"
                            ToolTip="Play the selected tracks (all shown when none is selected)" AutomationProperties.Name="Play" />
                    <Button Style="{StaticResource SkinButton}" Content="ENQUEUE" Width="34" Margin="2,0,0,0" Click="Enqueue_Click"
                            ToolTip="Add the selected tracks (all shown when none is selected) to the end of the playlist" AutomationProperties.Name="Enqueue" />
                    <Button x:Name="FoldersButton" Style="{StaticResource SkinButton}" Content="FOLDERS" Width="34" Margin="6,0,0,0" Click="Folders_Click"
                            ToolTip="Add or remove music folders, rescan" AutomationProperties.Name="Library folders">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FoldersMenu" />
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource LcdText}" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite" />
                <Thumb x:Name="Grip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="8" Height="8" Margin="0,0,-3,-1" Cursor="SizeNWSE"
                       Focusable="False" ToolTip="Drag to resize the library" DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M7,1 L1,7 M7,4 L4,7" Stroke="#9CA2B5" StrokeThickness="0.6" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</local:SkinWindow>
