<local:SkinWindow x:Class="Fernplay.App.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        xmlns:classic="clr-namespace:Fernplay.App.Classic"
        Title="Fernplay library" ShowInTaskbar="False">
    <!--
        Colours: every colour here is a DynamicResource "L.*" that LibraryWindow sets in code: Fernplay's own look, or the
        colours of a classic skin's GENEX.BMP (ApplyColors). Sizes are skin pixels, scaled by SkinWindow.Scale.
    -->
    <local:SkinWindow.Resources>
        <Style x:Key="LibInset" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource L.ListBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource L.Divider}" />
            <Setter Property="BorderThickness" Value="1,1,0,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="LibLabel" TargetType="TextBlock" BasedOn="{StaticResource SkinLabel}">
            <Setter Property="Foreground" Value="{DynamicResource L.Label}" />
        </Style>
        <Style x:Key="LibText" TargetType="TextBlock" BasedOn="{StaticResource LcdText}">
            <Setter Property="Foreground" Value="{DynamicResource L.ListText}" />
        </Style>

        <!-- Scroll bars: a narrow well with a bevelled thumb, in its own column. -->
        <Style x:Key="LibScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border BorderBrush="{DynamicResource L.BtnOutline}" BorderThickness="0.5" SnapsToDevicePixels="True">
                            <Border Background="{DynamicResource L.BtnFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="{DynamicResource L.BtnLight}">
                                <Border BorderThickness="0,0,0.5,0.5" BorderBrush="{DynamicResource L.BtnShadow}" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{DynamicResource L.ScrollBack}" BorderBrush="{DynamicResource L.Divider}" BorderThickness="0.5,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackBlank}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackBlank}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LibScrollThumb}" MinHeight="8" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Margin="{TemplateBinding Padding}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource LibScrollBar}" Margin="1,0,0,0"
                                       Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}"
                                       ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons on a classic skin: GENEX's button colours (face, light and shadow edges, outline), text in its button colour. -->
        <Style x:Key="GenButton" TargetType="ButtonBase">
            <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
            <Setter Property="Foreground" Value="{DynamicResource L.BtnText}" />
            <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
            <Setter Property="FontSize" Value="6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border BorderBrush="{DynamicResource L.BtnOutline}" BorderThickness="0.5" SnapsToDevicePixels="True">
                            <Border x:Name="Face" Background="{DynamicResource L.BtnFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="{DynamicResource L.BtnLight}">
                                <Border x:Name="Lower" BorderThickness="0,0,0.5,0.5" BorderBrush="{DynamicResource L.BtnShadow}">
                                    <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </Border>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource L.BtnPressed}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource L.BtnShadow}" />
                                <Setter TargetName="Lower" Property="BorderBrush" Value="{DynamicResource L.BtnLight}" />
                                <Setter TargetName="Content" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform X="0.5" Y="0.5" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Lists: a header row, the rows in the list colour, the selected row in the selection colour. -->
        <Style x:Key="LibHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{DynamicResource L.HeadBg}" BorderBrush="{DynamicResource L.HeadLine}" BorderThickness="0,0,0.5,0.5" Padding="2,0.5,2,0.5">
                                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource SkinLabel}" Foreground="{DynamicResource L.HeadText}" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="2" Margin="0,0,-1,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibRow" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource L.ListText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Row" Background="Transparent" Padding="0,0.5">
                            <local:TightRowPresenter TextBlock.FontFamily="{StaticResource SkinFont}" TextBlock.FontSize="7" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource L.SelBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource L.SelText}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:FocusRing.Visible" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource L.Focus}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="0.5" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibList" TargetType="ListView">
            <!-- The rows show their own focus ring; the list's own box would frame the whole pane. -->
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource LibRow}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
            <Setter Property="IsTextSearchEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <DockPanel>
                            <GridViewHeaderRowPresenter DockPanel.Dock="Top" Columns="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                                        ColumnHeaderContainerStyle="{StaticResource LibHeader}" />
                            <ScrollViewer x:Name="Scroller" Style="{StaticResource LibScrollViewer}" Focusable="False" CanContentScroll="True"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The navigation list: headings (not selectable) and indented views. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="2,0.5">
                            <TextBlock x:Name="Label" Text="{Binding Text}" Margin="{Binding Indent}" Style="{StaticResource LibText}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource L.Heading}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource L.SelBg}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource L.NavSelText}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:FocusRing.Visible" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource L.Focus}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="0.5" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibSearch" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource L.ListText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource L.ListText}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource L.SelBg}" />
            <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
            <Setter Property="FontSize" Value="7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Style="{StaticResource LibInset}" Padding="2,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:SkinWindow.Resources>

    <!--
        Shell: the window's size in screen DIPs (LibrarySize). Root holds the library at SkinWindow.Scale. On a classic skin
        Frame draws GEN.BMP around Root, and FrameTitle / FrameClose / FrameGrip take the mouse on it.
    -->
    <Grid x:Name="Shell" Width="782" Height="459">
        <classic:GenFrame x:Name="Frame" Visibility="Collapsed" />
        <Border x:Name="Root" Background="{DynamicResource L.Window}" BorderBrush="#5A5F72" BorderThickness="0.5">
            <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Background="{StaticResource TitleRibs}">
                    <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                        <TextBlock Text="FERNPLAY LIBRARY" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                        <Button Style="{StaticResource TitleButton}" Content="x" Click="Close_Click"
                                ToolTip="Hide the library (Alt+L)" AutomationProperties.Name="Hide the library" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="4,3,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource LibInset}">
                        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" FocusVisualStyle="{x:Null}"
                                 SelectionChanged="Nav_SelectionChanged" AutomationProperties.Name="Library views">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Style="{StaticResource LibScrollViewer}" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="11" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="68" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SEARCH" Style="{StaticResource LibLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource LibSearch}" TextChanged="Search_TextChanged"
                                     AutomationProperties.Name="Search the library" ToolTip="Artist, album, title, genre or year: every word must match" />
                            <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource SkinButton}" Content="CLEAR SEARCH" Height="10" Padding="4,0" Margin="3,0,0,0"
                                    Click="ClearSearch_Click" AutomationProperties.Name="Clear the search" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="68" />
                            </Grid.ColumnDefinitions>
                            <!-- Cover of the chosen album (or of the selected track): art in the file, else folder.jpg and the like. -->
                            <Border Grid.Column="4" Style="{StaticResource LibInset}">
                                <Grid>
                                    <TextBlock x:Name="NoCover" Text="NO COVER" Style="{StaticResource SkinLabel}" Foreground="{DynamicResource L.NoCover}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="Cover" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.Name="Album cover" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource LibInset}">
                                <ListView x:Name="ArtistList" Style="{StaticResource LibList}" SelectionMode="Single" SelectionChanged="Artist_SelectionChanged"
                                          MouseDoubleClick="Artist_DoubleClick" AutomationProperties.Name="Artists">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ARTIST" Width="92" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="ALBUMS" Width="30" DisplayMemberBinding="{Binding Albums}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource LibInset}">
                                <ListView x:Name="AlbumList" Style="{StaticResource LibList}" SelectionMode="Single" SelectionChanged="Album_SelectionChanged"
                                          MouseDoubleClick="Album_DoubleClick" AutomationProperties.Name="Albums">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ALBUM" Width="70" DisplayMemberBinding="{Binding Album}" />
                                            <GridViewColumn Header="ARTIST" Width="52" DisplayMemberBinding="{Binding Artist}" />
                                            <GridViewColumn Header="TRACKS" Width="30" DisplayMemberBinding="{Binding Tracks}" />
                                            <GridViewColumn Header="YEAR" Width="22" DisplayMemberBinding="{Binding Year}" />
                                            <GridViewColumn Header="GENRE" Width="34" DisplayMemberBinding="{Binding Genre}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                        </Grid>

                        <Border Grid.Row="4" Style="{StaticResource LibInset}">
                            <Grid>
                                <ListView x:Name="TrackList" Style="{StaticResource LibList}" SelectionMode="Extended"
                                          MouseDoubleClick="Track_DoubleClick" KeyDown="Track_KeyDown"
                                          PreviewMouseLeftButtonDown="Track_PreviewMouseDown" PreviewMouseMove="Track_PreviewMouseMove"
                                          AutomationProperties.Name="Tracks"
                                          AutomationProperties.HelpText="Enter or double-click plays, Shift+Enter enqueues; 0 to 5 rates; drag tracks to the playlist to add them">
                                    <ListView.View>
                                        <GridView x:Name="TrackColumns" />
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="EmptyText" Style="{StaticResource LcdText}" Foreground="{DynamicResource L.Empty}" TextWrapping="Wrap" TextAlignment="Center"
                                           VerticalAlignment="Center" Margin="20,0" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" Margin="4,3,4,2" Height="10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlayButton" Style="{StaticResource SkinButton}" Content="PLAY" Width="26" Click="Play_Click"
                                ToolTip="Play the selected tracks (all shown when none is selected)" AutomationProperties.Name="Play" />
                        <Button x:Name="EnqueueButton" Style="{StaticResource SkinButton}" Content="ENQUEUE" Width="34" Margin="2,0,0,0" Click="Enqueue_Click"
                                ToolTip="Add the selected tracks (all shown when none is selected) to the end of the playlist" AutomationProperties.Name="Enqueue" />
                        <Button x:Name="FoldersButton" Style="{StaticResource SkinButton}" Content="FOLDERS" Width="34" Margin="6,0,0,0" Click="Folders_Click"
                                ToolTip="Add or remove music folders, rescan" AutomationProperties.Name="Library folders">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="FoldersMenu" />
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource LcdText}" Foreground="{DynamicResource L.Status}" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite" />
                    <Thumb x:Name="Grip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="8" Height="8" Margin="0,0,-3,-1" Cursor="SizeNWSE"
                           Focusable="False" ToolTip="Drag to resize the library" DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Path Data="M7,1 L1,7 M7,4 L4,7" Stroke="#9CA2B5" StrokeThickness="0.6" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Grid>
            </Grid>
        </Border>

        <!-- Classic skin only: the title bar drags, the skin's close button hides, the bottom-right corner resizes. -->
        <Border x:Name="FrameTitle" VerticalAlignment="Top" Background="Transparent" Visibility="Collapsed" />
        <Button x:Name="FrameClose" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Click="Close_Click" Cursor="Hand"
                Focusable="False" ToolTip="Hide the library (Alt+L)" AutomationProperties.Name="Hide the library">
            <Button.Template>
                <ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate>
            </Button.Template>
        </Button>
        <Thumb x:Name="FrameGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" Cursor="SizeNWSE" Focusable="False"
               ToolTip="Drag to resize the library" DragStarted="Grip_DragStarted" DragDelta="Grip_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</local:SkinWindow>
