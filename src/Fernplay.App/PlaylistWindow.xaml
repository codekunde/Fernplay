<local:SkinWindow x:Class="Fernplay.App.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay playlist" ShowInTaskbar="False" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <local:SkinWindow.Resources>
        <!-- Rows on a classic skin: PLEDIT.TXT colours and font, set as PlNormal, PlCurrent, PlSelectedBg, PlFont on the list. -->
        <Style x:Key="ClassicRowContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" Height="13" Padding="2,0,2,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PlSelectedBg}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="local:FocusRing.Visible" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource PlNormal}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="0.5" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClassicRowText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PlNormal}" />
            <Setter Property="FontFamily" Value="{DynamicResource PlFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PlCurrent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ClassicRowTemplate" DataType="{x:Type local:PlaylistRow}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" Style="{StaticResource ClassicRowText}" Margin="6,0,0,0" />
                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Style="{StaticResource ClassicRowText}" />
            </DockPanel>
        </DataTemplate>
    </local:SkinWindow.Resources>
    <Grid>
    <!-- A classic skin (.wsz) is built in code into ClassicHost, and the list (ListHost) moves into its frame. -->
    <ContentControl x:Name="ClassicHost" Focusable="False" Visibility="Collapsed" />
    <Border x:Name="FernplayView" Width="280" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Style="{StaticResource TitleBar}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY PLAYLIST" Style="{StaticResource TitleLabel}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" Content="x" Click="Close_Click"
                            ToolTip="Hide the playlist" AutomationProperties.Name="Hide the playlist" />
                </Border>
            </Grid>

            <Border x:Name="ListBorder" Style="{StaticResource Inset}" Margin="6,4,6,0" Height="116">
                <Grid x:Name="ListHost">
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0"
                             SelectionMode="Extended" IsTextSearchEnabled="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Item"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                             PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="List_PreviewMouseUp"
                             DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop"
                             AutomationProperties.Name="Playlist"
                             AutomationProperties.HelpText="Drag tracks, or press Alt+Up and Alt+Down, to change the order. Alt+3 edits the tags.">
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="RowMenu" Opened="RowMenu_Opened">
                                <MenuItem x:Name="RowMenuInfo" Header="File info…   Alt+3" Click="FileInfo_Click" />
                                <MenuItem x:Name="RowMenuRemove" Header="Remove   Del" Click="Remove_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer x:Name="Scroller" Style="{StaticResource SkinScrollViewer}" Focusable="False" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" Padding="2,0.5,3,0.5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1D4A26" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsKeyboardFocused" Value="True" />
                                                        <Condition Property="local:FocusRing.Visible" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="#6FAE62" />
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="0.5" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PlaylistRow}">
                                <DataTemplate.Resources>
                                    <!-- Green; the playing row white, its length included. -->
                                    <Style x:Key="RowText" TargetType="TextBlock" BasedOn="{StaticResource LcdText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Foreground" Value="#F2F4F8" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataTemplate.Resources>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Length}" Style="{StaticResource RowText}" Margin="6,0,0,0"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Style="{StaticResource RowText}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource LcdText}" Foreground="#2E8A43" TextWrapping="Wrap" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="20,0" IsHitTestVisible="False"
                               Text="The playlist is empty. Press ADD, or drop music files, folders or playlists here." />
                    <!-- Where dragged tracks will land. -->
                    <Border x:Name="DropLine" Height="1" Background="{StaticResource Amber}" VerticalAlignment="Top"
                            Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Grid Margin="6,4,6,1" Height="10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddButton" Style="{StaticResource SkinButton}" Content="ADD" Width="24" Click="Add_Click"
                            ToolTip="Add files or a folder to the end of the list" AutomationProperties.Name="Add">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AddMenu">
                                <MenuItem Header="Add files…" Click="AddFiles_Click" />
                                <MenuItem Header="Add folder…" Click="AddFolder_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="RemoveButton" Style="{StaticResource SkinButton}" Content="REM" Width="24" Margin="2,0,0,0" Click="Remove_Click"
                            ToolTip="Remove the selected tracks (Delete)" AutomationProperties.Name="Remove selected" />
                    <Button x:Name="ClearButton" Style="{StaticResource SkinButton}" Content="CLEAR" Width="28" Margin="2,0,0,0" Click="Clear_Click"
                            ToolTip="Empty the playlist" AutomationProperties.Name="Clear the playlist" />
                    <Button x:Name="ListButton" Style="{StaticResource SkinButton}" Content="LIST" Width="24" Margin="6,0,0,0" Click="List_Click"
                            ToolTip="Open or save a playlist (.m3u, .m3u8)" AutomationProperties.Name="Playlist file">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ListMenu">
                                <MenuItem Header="Open playlist…" Click="OpenList_Click" />
                                <MenuItem Header="Save playlist…" Click="SaveList_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <Border Style="{StaticResource Inset}" HorizontalAlignment="Right" Padding="3,0">
                    <TextBlock x:Name="TotalText" Style="{StaticResource LcdText}" FontSize="6" VerticalAlignment="Center" Text="0 tracks" />
                </Border>
            </Grid>

            <!-- Bottom edge: drag to make the list taller or shorter (snaps to whole rows). -->
            <Thumb x:Name="SizeGrip" Height="5" Cursor="SizeNS" Focusable="False"
                   DragStarted="SizeGrip_DragStarted" DragDelta="SizeGrip_DragDelta" DragCompleted="SizeGrip_DragCompleted"
                   ToolTip="Drag to make the playlist taller or shorter">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <!-- Two ribs, one screen pixel each at 1.7x; brighter on hover. -->
                            <StackPanel x:Name="Ribs" HorizontalAlignment="Center" VerticalAlignment="Center" Width="28" Opacity="0.75">
                                <Rectangle Height="0.6" Fill="#9CA2B5" Margin="0,0,0,1" />
                                <Rectangle Height="0.6" Fill="#9CA2B5" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ribs" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </StackPanel>
    </Border>
    </Grid>
</local:SkinWindow>
