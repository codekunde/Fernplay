<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Fernplay</AssemblyName>
    <RootNamespace>Fernplay.App</RootNamespace>
    <Version>0.10.0</Version>
    <Product>Fernplay</Product>
    <Company>CodeKunde</Company>
    <Authors>CodeKunde</Authors>
    <Copyright>Copyright (c) 2026 CodeKunde</Copyright>
    <!-- Fluent theme (ThemeMode) is marked experimental in WPF; it is what makes the app follow Windows light/dark. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- MediaSession.cs calls Windows' media session through COM function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Exe, window and taskbar icon. Redraw both icons with tools/Make-FernplayIcons.ps1. -->
    <ApplicationIcon>Assets\Fernplay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon inside the app (title-bar menu button, About). -->
    <Resource Include="Assets\Fernplay.ico" />
    <!-- File icon for audio files and playlists opened with Fernplay; shipped next to the exe for the file association. -->
    <None Include="Assets\FernplayFile.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- One exe that uses the installed .NET 10 Desktop Runtime (x64). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fernplay.Core\Fernplay.Core.csproj" />
  </ItemGroup>

  <!--
    The visualizer: libprojectM 4.1.8 (LGPL-2.1, unmodified) and GLEW 2.2.0 as separate DLLs next to Fernplay.exe, never
    inside the single file, with their licence texts. Built by tools/Build-ProjectM.ps1 into lib/projectM.
  -->
  <ItemGroup>
    <None Include="..\..\lib\projectM\win-x64\*.dll" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\lib\projectM\licenses\*" Link="licenses\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
