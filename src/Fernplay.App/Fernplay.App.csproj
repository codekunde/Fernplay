<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Fernplay</AssemblyName>
    <RootNamespace>Fernplay.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Fernplay</Product>
    <Company>CodeKunde</Company>
    <Authors>CodeKunde</Authors>
    <Copyright>Copyright (c) 2026 CodeKunde</Copyright>
    <!-- Fluent theme (ThemeMode) is marked experimental in WPF; it is what makes the app follow Windows light/dark. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- One exe that uses the installed .NET 10 Desktop Runtime (x64). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fernplay.Core\Fernplay.Core.csproj" />
  </ItemGroup>

</Project>
