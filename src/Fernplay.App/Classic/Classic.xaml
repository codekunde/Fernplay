<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Fernplay.App"
                    xmlns:c="clr-namespace:Fernplay.App.Classic">
    <!-- Controls of a classic skin: each one is its sprite, nothing else. Pixel-exact, so no smoothing. -->

    <BooleanToVisibilityConverter x:Key="ClassicBoolToVisibility" />

    <!-- Focus ring for the keyboard only (FocusRing.Visible), 1 skin pixel thin. -->
    <Style x:Key="ClassicFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" Stroke="#FFE070" StrokeThickness="0.5" StrokeDashArray="1 1"
                               Visibility="{Binding Path=(local:FocusRing.Visible), RelativeSource={RelativeSource Self}, Converter={StaticResource ClassicBoolToVisibility}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:SpriteButton}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ClassicFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SpriteButton}">
                    <Grid Background="Transparent">
                        <Image x:Name="Img" Source="{TemplateBinding Normal}" Stretch="Fill" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Img" Property="Source" Value="{Binding Pressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:SpriteToggle}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ClassicFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SpriteToggle}">
                    <Grid Background="Transparent">
                        <Image x:Name="Img" Source="{TemplateBinding Off}" Stretch="Fill" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Img" Property="Source" Value="{Binding OffPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Img" Property="Source" Value="{Binding On, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Img" Property="Source" Value="{Binding OnPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible halves of the bar either side of the knob (a click there jumps the knob: IsMoveToPointEnabled). -->
    <Style x:Key="ClassicTrackHalf" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type c:SpriteSlider}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ClassicFocus}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:SpriteSlider}">
                    <Grid Background="Transparent">
                        <Image Source="{TemplateBinding BackgroundImage}" Stretch="Fill" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ClassicTrackHalf}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ClassicTrackHalf}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Knob" Width="{TemplateBinding ThumbWidth}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Track}}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Image x:Name="KnobImg" VerticalAlignment="Top" Stretch="Fill"
                                                       Source="{Binding ThumbImage, RelativeSource={RelativeSource AncestorType=c:SpriteSlider}}"
                                                       Width="{Binding ThumbWidth, RelativeSource={RelativeSource AncestorType=c:SpriteSlider}}"
                                                       Height="{Binding ThumbHeight, RelativeSource={RelativeSource AncestorType=c:SpriteSlider}}"
                                                       Margin="{Binding ThumbTop, RelativeSource={RelativeSource AncestorType=c:SpriteSlider}, Converter={x:Static c:TopMargin.Instance}}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="KnobImg" Property="Source" Value="{Binding ThumbPressedImage, RelativeSource={RelativeSource AncestorType=c:SpriteSlider}}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Nothing to seek (stopped, or a live station): the knob goes, as on the classic player. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
