<local:SkinDialog x:Class="Fernplay.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="About Fernplay">
    <Border Width="190" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Style="{StaticResource TitleBar}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="ABOUT FERNPLAY" Style="{StaticResource TitleLabel}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button Style="{StaticResource TitleButton}" Content="x" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close about" />
                </Border>
            </Grid>

            <Grid Margin="8,8,8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="FERNPLAY" Style="{StaticResource SkinLabel}" FontSize="9" Foreground="{StaticResource TitleText}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource LcdText}" FontSize="6" Foreground="{StaticResource Amber}" Margin="0,1,0,0" />
                    <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" Foreground="{StaticResource SkinText}" Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="A small music player in the classic style: player, equalizer and playlist." />
                    <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Free and open source under the MIT licence. Sound through NAudio (MIT) and the decoders built into Windows." />
                    <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" Margin="0,4,0,0" Text="© 2026 CodeKunde" />
                </StackPanel>
            </Grid>
            <!-- Update check: only when pressed; says the result here (and offers the download page when there is a newer one). -->
            <TextBlock x:Name="UpdateText" Style="{StaticResource SkinLabel}" FontWeight="Normal" Foreground="{StaticResource SkinText}" Margin="8,0,8,5"
                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,8,7">
                <Button x:Name="UpdateButton" Style="{StaticResource SkinButton}" Content="CHECK FOR UPDATE" Height="11" Padding="6,0" Margin="0,0,4,0"
                        Click="CheckUpdate_Click" ToolTip="Ask GitHub whether a newer Fernplay is out" AutomationProperties.Name="Check for update" />
                <Button x:Name="DownloadButton" Style="{StaticResource SkinButton}" Content="DOWNLOAD" Height="11" Padding="6,0" Margin="0,0,4,0"
                        Visibility="Collapsed" Click="Download_Click" ToolTip="Open the release page in the browser" AutomationProperties.Name="Open the download page" />
                <Button Style="{StaticResource SkinButton}" Content="CLOSE" Height="11" Padding="8,0"
                        IsDefault="True" Click="Close_Click" AutomationProperties.Name="Close about" />
            </StackPanel>
        </StackPanel>
    </Border>
</local:SkinDialog>
