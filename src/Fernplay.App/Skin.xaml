<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Fernplay.App">
    <!--
        Fernplay's own skin in the late-90s player style: bevelled charcoal panels, green LCD, fern-green title bars.
        All drawn here and in code; no bitmaps. Sizes are in "skin pixels": every window is scaled 2x.
    -->

    <!-- Palette -->
    <Color x:Key="FrameDarkColor">#1A1C23</Color>
    <Color x:Key="FrameColor">#2A2D38</Color>
    <Color x:Key="FrameLightColor">#4A4F62</Color>
    <Color x:Key="ShadowColor">#08090C</Color>
    <Color x:Key="LcdColor">#030604</Color>
    <Color x:Key="LcdGreenColor">#4BE868</Color>
    <Color x:Key="LcdDimColor">#123A1C</Color>
    <Color x:Key="FernColor">#5FA052</Color>
    <Color x:Key="FernDarkColor">#2A4E27</Color>
    <Color x:Key="TextColor">#D7DAE3</Color>

    <SolidColorBrush x:Key="FrameDark" Color="{StaticResource FrameDarkColor}" />
    <SolidColorBrush x:Key="Frame" Color="{StaticResource FrameColor}" />
    <SolidColorBrush x:Key="FrameLight" Color="{StaticResource FrameLightColor}" />
    <SolidColorBrush x:Key="Shadow" Color="{StaticResource ShadowColor}" />
    <SolidColorBrush x:Key="Lcd" Color="{StaticResource LcdColor}" />
    <SolidColorBrush x:Key="LcdGreen" Color="{StaticResource LcdGreenColor}" />
    <SolidColorBrush x:Key="LcdDim" Color="{StaticResource LcdDimColor}" />
    <SolidColorBrush x:Key="Fern" Color="{StaticResource FernColor}" />
    <SolidColorBrush x:Key="SkinText" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SkinTextDim" Color="#8E93A3" />

    <!-- Panel body: brushed charcoal. -->
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#343846" Offset="0" />
        <GradientStop Color="#262934" Offset="0.5" />
        <GradientStop Color="#1E2029" Offset="1" />
    </LinearGradientBrush>

    <!--
        Title bar ribbing: three evenly spaced amber bars with a lighter top edge. Positions are in skin px but chosen so that
        at the 1.7 scale (bar 2 px below the panel top) each bar is exactly 2 screen px (1 light, 1 amber) with 3 px gaps:
        crisp at 100 %. A gradient with hard stops, not a tiled DrawingBrush: WPF scales a tile as a bitmap, which blurs the edges.
    -->
    <LinearGradientBrush x:Key="TitleRibs" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B3112" Offset="0" />
        <GradientStop Color="#3B3112" Offset="0.1529" />
        <GradientStop Color="#B39834" Offset="0.1529" />
        <GradientStop Color="#B39834" Offset="0.2118" />
        <GradientStop Color="#8A7424" Offset="0.2118" />
        <GradientStop Color="#8A7424" Offset="0.2706" />
        <GradientStop Color="#3B3112" Offset="0.2706" />
        <GradientStop Color="#3B3112" Offset="0.4471" />
        <GradientStop Color="#B39834" Offset="0.4471" />
        <GradientStop Color="#B39834" Offset="0.5059" />
        <GradientStop Color="#8A7424" Offset="0.5059" />
        <GradientStop Color="#8A7424" Offset="0.5647" />
        <GradientStop Color="#3B3112" Offset="0.5647" />
        <GradientStop Color="#3B3112" Offset="0.7412" />
        <GradientStop Color="#B39834" Offset="0.7412" />
        <GradientStop Color="#B39834" Offset="0.8" />
        <GradientStop Color="#8A7424" Offset="0.8" />
        <GradientStop Color="#8A7424" Offset="0.8588" />
        <GradientStop Color="#3B3112" Offset="0.8588" />
        <GradientStop Color="#3B3112" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TitleText" Color="#F2E19A" />

    <LinearGradientBrush x:Key="ButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#666B7C" Offset="0" />
        <GradientStop Color="#454959" Offset="0.55" />
        <GradientStop Color="#363946" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFaceHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#767B8E" Offset="0" />
        <GradientStop Color="#525667" Offset="0.55" />
        <GradientStop Color="#3E4150" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFacePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C2F3A" Offset="0" />
        <GradientStop Color="#3A3D4B" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="SkinFont">Tahoma</FontFamily>

    <!-- Keyboard focus: a fern-green dotted ring on every control, shown only while the keyboard is in use (FocusRing.cs). -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="SkinFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" Stroke="#9BE38C" StrokeThickness="0.75" StrokeDashArray="1.5 1" SnapsToDevicePixels="True"
                               Visibility="{Binding Path=(local:FocusRing.Visible), RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset well: LCD screens and grooves sit in one. -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lcd}" />
        <Setter Property="BorderBrush" Value="{StaticResource Shadow}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A text field in an inset well (file info): light text on the LCD black, amber edge while it has the caret. -->
    <Style x:Key="SkinTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource SkinText}" />
        <Setter Property="CaretBrush" Value="{StaticResource TitleText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Fern}" />
        <Setter Property="SelectionTextBrush" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="MinHeight" Value="11" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Well" Background="{StaticResource Lcd}" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" Padding="2,0.5"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource TitleText}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="Background" Value="#0A0F0B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LcdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="Foreground" Value="{StaticResource LcdGreen}" />
    </Style>

    <Style x:Key="SkinLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="6" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SkinTextDim}" />
    </Style>

    <!-- Title bars: lit while their panel is the active window (keys go there), dull otherwise, as on the classic
         players. The dull title text keeps 5.6:1 on FrameDark. -->
    <SolidColorBrush x:Key="TitleTextInactive" Color="#9A9480" />
    <LinearGradientBrush x:Key="TitleRibsInactive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2820" Offset="0" />
        <GradientStop Color="#2A2820" Offset="0.1529" />
        <GradientStop Color="#6E6754" Offset="0.1529" />
        <GradientStop Color="#6E6754" Offset="0.2118" />
        <GradientStop Color="#57513F" Offset="0.2118" />
        <GradientStop Color="#57513F" Offset="0.2706" />
        <GradientStop Color="#2A2820" Offset="0.2706" />
        <GradientStop Color="#2A2820" Offset="0.4471" />
        <GradientStop Color="#6E6754" Offset="0.4471" />
        <GradientStop Color="#6E6754" Offset="0.5059" />
        <GradientStop Color="#57513F" Offset="0.5059" />
        <GradientStop Color="#57513F" Offset="0.5647" />
        <GradientStop Color="#2A2820" Offset="0.5647" />
        <GradientStop Color="#2A2820" Offset="0.7412" />
        <GradientStop Color="#6E6754" Offset="0.7412" />
        <GradientStop Color="#6E6754" Offset="0.8" />
        <GradientStop Color="#57513F" Offset="0.8" />
        <GradientStop Color="#57513F" Offset="0.8588" />
        <GradientStop Color="#2A2820" Offset="0.8588" />
        <GradientStop Color="#2A2820" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="TitleBar" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource TitleRibs}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Background" Value="{StaticResource TitleRibsInactive}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TitleLabel" TargetType="TextBlock" BasedOn="{StaticResource SkinLabel}">
        <Setter Property="Foreground" Value="{StaticResource TitleText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TitleTextInactive}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Bevelled push button. Content is a glyph path or short caps text. -->
    <Style x:Key="SkinButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="Foreground" Value="{StaticResource SkinText}" />
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="6" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Outline" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border x:Name="Face" Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#8A90A3">
                            <Border x:Name="Lower" BorderThickness="0,0,0.5,0.5" BorderBrush="#24262F">
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFacePressed}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="#1A1C23" />
                            <Setter TargetName="Lower" Property="BorderBrush" Value="#5A5F70" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="0.5" Y="0.5" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle with an LED: lit green when on. Text comes from Content. -->
    <Style x:Key="LedToggle" TargetType="ToggleButton" BasedOn="{StaticResource SkinButton}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Padding" Value="2,0,3,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Outline" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border x:Name="Face" Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#8A90A3">
                            <Border x:Name="Lower" BorderThickness="0,0,0.5,0.5" BorderBrush="#24262F" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="Led" Width="3" Height="3" Fill="#1D3A1F" Stroke="#0B140C" StrokeThickness="0.4" Margin="0,0,2,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Led" Property="Fill" Value="#6CFF7E" />
                            <Setter TargetName="Led" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#6CFF7E" BlurRadius="4" ShadowDepth="0" Opacity="0.9" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFacePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiny title-bar buttons (minimise, close). -->
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource SkinButton}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="FontSize" Value="5" />
        <Setter Property="Margin" Value="1,0,0,0" />
    </Style>

    <!-- Slider parts -->
    <Style x:Key="TrackBlank" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The filled part of a slider (left of / below the thumb); colour comes from the slider's Foreground. -->
    <Style x:Key="TrackFillH" TargetType="RepeatButton" BasedOn="{StaticResource TrackBlank}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="2" Margin="0.5,0,0,0" Background="{TemplateBinding Background}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackFillV" TargetType="RepeatButton" BasedOn="{StaticResource TrackBlank}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Width="3" Margin="0.5,0,0,0" Background="{TemplateBinding Background}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#9CA2B5">
                            <Rectangle Width="0.6" Fill="#24262F" HorizontalAlignment="Center" Margin="0,1.5" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Horizontal slider: groove with a fill up to the thumb. Foreground = fill brush.
        Used for position (seek) and volume.
    -->
    <!-- Balance: the same well and knob as the volume, no fill, a tick at the centre. -->
    <Style x:Key="SkinBalanceSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Style="{StaticResource Inset}" Height="4" Background="#0E1014" BorderThickness="0.5,0.5,0,0" />
                        <Rectangle Width="0.6" Height="4" Fill="#8A7424" HorizontalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackBlank}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackBlank}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SkinThumb}" Width="9" Height="7" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinSliderH" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource Fern}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Style="{StaticResource Inset}" Height="4" Background="#0E1014" BorderThickness="0.5,0.5,0,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFillH}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackBlank}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SkinThumb}" Width="13" Height="7" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical EQ slider: narrow well, coloured bar from the bottom to the thumb (colour set in code by value). -->
    <Style x:Key="EqSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Minimum" Value="-12" />
        <Setter Property="Maximum" Value="12" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="3" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Foreground" Value="#E3CF4A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Style="{StaticResource Inset}" Width="5" Background="#0E1014" BorderThickness="0.5,0.5,0,0" />
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFillV}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackBlank}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SkinThumb}" Width="11" Height="6" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bar (playlist): narrow well, bevelled thumb. Sits in its own column, never over the text. -->
    <Style x:Key="SkinScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#9CA2B5" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="#0E1014" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5,0,0,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackBlank}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackBlank}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SkinScrollThumb}" MinHeight="8" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SkinScrollBar}" Margin="1,0,0,0"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Value="{TemplateBinding VerticalOffset}"
                                   ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   AutomationProperties.Name="Scroll the playlist" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glyphs for the transport buttons (own drawings). -->
    <Geometry x:Key="GlyphPrev">M0,0 H1.4 V7 H0 Z M8,0 L1.6,3.5 L8,7 Z</Geometry>
    <Geometry x:Key="GlyphPlay">M0,0 L7,3.5 L0,7 Z</Geometry>
    <Geometry x:Key="GlyphPause">M0,0 H2.4 V7 H0 Z M4.2,0 H6.6 V7 H4.2 Z</Geometry>
    <Geometry x:Key="GlyphStop">M0,0 H7 V7 H0 Z</Geometry>
    <Geometry x:Key="GlyphNext">M0,0 L6.4,3.5 L0,7 Z M6.6,0 H8 V7 H6.6 Z</Geometry>
    <Geometry x:Key="GlyphOpen">M0,4.2 L4,0 L8,4.2 Z M0,5.4 H8 V7 H0 Z</Geometry>

    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource SkinText}" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- The transport glyphs shrunk for the 8 px buttons of the rolled-up strip and the title bar. -->
    <Style x:Key="MiniGlyph" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="4.5" />
        <Setter Property="Height" Value="4.5" />
    </Style>
    <!-- Windowshade: roll up (an arrow up to a bar) and roll down (an arrow down to a bar). -->
    <Geometry x:Key="GlyphShade">M0,0 H7 V1.4 H0 Z M3.5,2.4 L7,7 L0,7 Z</Geometry>
    <Geometry x:Key="GlyphUnshade">M0,0 L7,0 L3.5,4.6 Z M0,5.6 H7 V7 H0 Z</Geometry>

    <!--
        Context menus (presets, open, add): own templates so the Fluent theme's icon column and accent colour
        do not show. Amber LCD text on charcoal; the highlighted item is a solid amber bar with dark text.
    -->
    <Color x:Key="AmberColor">#E8C547</Color>
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#1A1C23" />
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="BorderBrush" Value="#5A5F72" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="2" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,3" Background="#4A4F62" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box with an amber LED (settings). -->
    <Style x:Key="SkinCheck" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="Foreground" Value="{StaticResource SkinText}" />
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="6" Height="6" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" Background="#0E1014" VerticalAlignment="Center">
                            <Rectangle x:Name="Led" Margin="1" Fill="#3A3214" />
                        </Border>
                        <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Led" Property="Fill" Value="{StaticResource Amber}" />
                            <Setter TargetName="Led" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="{StaticResource AmberColor}" BlurRadius="4" ShadowDepth="0" Opacity="0.9" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Amber}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="10,3,18,3" MinWidth="110" SnapsToDevicePixels="True">
                            <DockPanel>
                                <!-- A submenu (EQ: Delete preset) shows an arrow and opens to the right. -->
                                <Path x:Name="Arrow" DockPanel.Dock="Right" Data="M0,0 L4,4 L0,8 Z" Fill="{TemplateBinding Foreground}"
                                      VerticalAlignment="Center" Margin="10,0,-10,0" Visibility="Collapsed" />
                                <!-- A checkable item that is on (app menu: Crossfade) shows a tick at the right. -->
                                <Path x:Name="Check" DockPanel.Dock="Right" Data="M0,4 L3,7 L8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      VerticalAlignment="Center" Margin="10,0,-12,0" Visibility="Collapsed" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-3" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="#1A1C23" BorderBrush="#5A5F72" BorderThickness="1" Padding="2" SnapsToDevicePixels="True"
                                    TextElement.FontFamily="{StaticResource SkinFont}" TextElement.FontSize="12">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Amber}" />
                            <Setter Property="Foreground" Value="#1A1C23" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
