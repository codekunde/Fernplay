<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Fernplay's own skin in the late-90s player style: bevelled charcoal panels, green LCD, fern-green title bars.
        All drawn here and in code; no bitmaps. Sizes are in "skin pixels": every window is scaled 2x.
    -->

    <!-- Palette -->
    <Color x:Key="FrameDarkColor">#1A1C23</Color>
    <Color x:Key="FrameColor">#2A2D38</Color>
    <Color x:Key="FrameLightColor">#4A4F62</Color>
    <Color x:Key="ShadowColor">#08090C</Color>
    <Color x:Key="LcdColor">#030604</Color>
    <Color x:Key="LcdGreenColor">#4BE868</Color>
    <Color x:Key="LcdDimColor">#123A1C</Color>
    <Color x:Key="FernColor">#5FA052</Color>
    <Color x:Key="FernDarkColor">#2A4E27</Color>
    <Color x:Key="TextColor">#D7DAE3</Color>

    <SolidColorBrush x:Key="FrameDark" Color="{StaticResource FrameDarkColor}" />
    <SolidColorBrush x:Key="Frame" Color="{StaticResource FrameColor}" />
    <SolidColorBrush x:Key="FrameLight" Color="{StaticResource FrameLightColor}" />
    <SolidColorBrush x:Key="Shadow" Color="{StaticResource ShadowColor}" />
    <SolidColorBrush x:Key="Lcd" Color="{StaticResource LcdColor}" />
    <SolidColorBrush x:Key="LcdGreen" Color="{StaticResource LcdGreenColor}" />
    <SolidColorBrush x:Key="LcdDim" Color="{StaticResource LcdDimColor}" />
    <SolidColorBrush x:Key="Fern" Color="{StaticResource FernColor}" />
    <SolidColorBrush x:Key="SkinText" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SkinTextDim" Color="#8E93A3" />

    <!-- Panel body: brushed charcoal. -->
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#343846" Offset="0" />
        <GradientStop Color="#262934" Offset="0.5" />
        <GradientStop Color="#1E2029" Offset="1" />
    </LinearGradientBrush>

    <!-- Title bar ribbing: fine horizontal fern-green grooves. -->
    <DrawingBrush x:Key="TitleRibs" TileMode="Tile" Viewport="0,0,4,2" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#3E7038" Geometry="M0,0 H4 V1 H0 Z" />
                <GeometryDrawing Brush="#1F3A1D" Geometry="M0,1 H4 V2 H0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="ButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#666B7C" Offset="0" />
        <GradientStop Color="#454959" Offset="0.55" />
        <GradientStop Color="#363946" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFaceHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#767B8E" Offset="0" />
        <GradientStop Color="#525667" Offset="0.55" />
        <GradientStop Color="#3E4150" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonFacePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C2F3A" Offset="0" />
        <GradientStop Color="#3A3D4B" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="SkinFont">Tahoma</FontFamily>

    <!-- Keyboard focus: a fern-green dotted ring, visible on every control. -->
    <Style x:Key="SkinFocus">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-1" Stroke="#9BE38C" StrokeThickness="0.75" StrokeDashArray="1.5 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset well: LCD screens and grooves sit in one. -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lcd}" />
        <Setter Property="BorderBrush" Value="{StaticResource Shadow}" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="LcdText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="7" />
        <Setter Property="Foreground" Value="{StaticResource LcdGreen}" />
    </Style>

    <Style x:Key="SkinLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="6" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource SkinTextDim}" />
    </Style>

    <!-- Bevelled push button. Content is a glyph path or short caps text. -->
    <Style x:Key="SkinButton" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="Foreground" Value="{StaticResource SkinText}" />
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="6" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Outline" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border x:Name="Face" Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#8A90A3">
                            <Border x:Name="Lower" BorderThickness="0,0,0.5,0.5" BorderBrush="#24262F">
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFacePressed}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="#1A1C23" />
                            <Setter TargetName="Lower" Property="BorderBrush" Value="#5A5F70" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="0.5" Y="0.5" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle with an LED: lit green when on. Text comes from Content. -->
    <Style x:Key="LedToggle" TargetType="ToggleButton" BasedOn="{StaticResource SkinButton}">
        <Setter Property="Height" Value="10" />
        <Setter Property="Padding" Value="2,0,3,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Outline" BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border x:Name="Face" Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#8A90A3">
                            <Border x:Name="Lower" BorderThickness="0,0,0.5,0.5" BorderBrush="#24262F" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle x:Name="Led" Width="3" Height="3" Fill="#1D3A1F" Stroke="#0B140C" StrokeThickness="0.4" Margin="0,0,2,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Led" Property="Fill" Value="#6CFF7E" />
                            <Setter TargetName="Led" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#6CFF7E" BlurRadius="4" ShadowDepth="0" Opacity="0.9" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ButtonFacePressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tiny title-bar buttons (minimise, close). -->
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource SkinButton}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="FontSize" Value="5" />
        <Setter Property="Margin" Value="1,0,0,0" />
    </Style>

    <!-- Slider parts -->
    <Style x:Key="TrackBlank" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The filled part of a slider (left of / below the thumb); colour comes from the slider's Foreground. -->
    <Style x:Key="TrackFillH" TargetType="RepeatButton" BasedOn="{StaticResource TrackBlank}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="2" Margin="0.5,0,0,0" Background="{TemplateBinding Background}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackFillV" TargetType="RepeatButton" BasedOn="{StaticResource TrackBlank}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Width="3" Margin="0.5,0,0,0" Background="{TemplateBinding Background}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border BorderBrush="{StaticResource Shadow}" BorderThickness="0.5" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource ButtonFace}" BorderThickness="0.5,0.5,0,0" BorderBrush="#9CA2B5">
                            <Rectangle Width="0.6" Fill="#24262F" HorizontalAlignment="Center" Margin="0,1.5" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Horizontal slider: groove with a fill up to the thumb. Foreground = fill brush.
        Used for position (seek) and volume.
    -->
    <Style x:Key="SkinSliderH" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource Fern}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Style="{StaticResource Inset}" Height="4" Background="#0E1014" BorderThickness="0.5,0.5,0,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFillH}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackBlank}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SkinThumb}" Width="13" Height="7" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical EQ slider: narrow well, coloured bar from the bottom to the thumb (colour set in code by value). -->
    <Style x:Key="EqSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource SkinFocus}" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Minimum" Value="-12" />
        <Setter Property="Maximum" Value="12" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="3" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Foreground" Value="#E3CF4A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Style="{StaticResource Inset}" Width="5" Background="#0E1014" BorderThickness="0.5,0.5,0,0" />
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackFillV}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackBlank}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SkinThumb}" Width="11" Height="6" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glyphs for the transport buttons (own drawings). -->
    <Geometry x:Key="GlyphPrev">M0,0 H1.4 V7 H0 Z M8,0 L1.6,3.5 L8,7 Z</Geometry>
    <Geometry x:Key="GlyphPlay">M0,0 L7,3.5 L0,7 Z</Geometry>
    <Geometry x:Key="GlyphPause">M0,0 H2.4 V7 H0 Z M4.2,0 H6.6 V7 H4.2 Z</Geometry>
    <Geometry x:Key="GlyphStop">M0,0 H7 V7 H0 Z</Geometry>
    <Geometry x:Key="GlyphNext">M0,0 L6.4,3.5 L0,7 Z M6.6,0 H8 V7 H6.6 Z</Geometry>
    <Geometry x:Key="GlyphOpen">M0,4.2 L4,0 L8,4.2 Z M0,5.4 H8 V7 H0 Z</Geometry>

    <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource SkinText}" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- Context menus in the same colours. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#22252E" />
        <Setter Property="Foreground" Value="{StaticResource SkinText}" />
        <Setter Property="BorderBrush" Value="#4A4F62" />
        <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
