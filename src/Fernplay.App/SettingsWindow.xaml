<local:SkinDialog x:Class="Fernplay.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay settings">
    <Border Width="190" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Background="{StaticResource TitleRibs}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY SETTINGS" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button Style="{StaticResource TitleButton}" Content="x" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close settings" />
                </Border>
            </Grid>

            <StackPanel Margin="8,8,8,7">
                <CheckBox x:Name="OnTopCheck" Style="{StaticResource SkinCheck}" Content="Keep Fernplay on top of other windows"
                          Checked="Option_Changed" Unchecked="Option_Changed" />
                <CheckBox x:Name="SnapCheck" Style="{StaticResource SkinCheck}" Content="Snap panels to each other and the screen edges" Margin="0,6,0,0"
                          Checked="Option_Changed" Unchecked="Option_Changed" />
                <CheckBox x:Name="RememberCheck" Style="{StaticResource SkinCheck}" Content="Remember the playlist between runs" Margin="0,6,0,0"
                          Checked="Option_Changed" Unchecked="Option_Changed" />
                <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="10,9,0,0" TextWrapping="Wrap"
                           Text="Changes apply at once and are saved when Fernplay closes." />
                <Button Style="{StaticResource SkinButton}" Content="CLOSE" Height="11" Padding="8,0" Margin="0,7,0,0" HorizontalAlignment="Right"
                        IsDefault="True" Click="Close_Click" AutomationProperties.Name="Close settings" />
            </StackPanel>
        </StackPanel>
    </Border>
</local:SkinDialog>
