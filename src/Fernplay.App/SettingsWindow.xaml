<local:SkinDialog x:Class="Fernplay.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay settings">
    <Border Width="190" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Style="{StaticResource TitleBar}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY SETTINGS" Style="{StaticResource TitleLabel}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button Style="{StaticResource TitleButton}" Content="x" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close settings" />
                </Border>
            </Grid>

            <StackPanel Margin="8,8,8,7">
                <!-- Tabs: the page not shown is Hidden, not Collapsed, so the window keeps one height. -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="GeneralTab" GroupName="SettingsTab" Style="{StaticResource LedToggle}" Content="GENERAL" Checked="Tab_Checked"
                                 ToolTip="Windows, playlist, volume levelling, Explorer and skin" AutomationProperties.Name="General settings" />
                    <RadioButton x:Name="AdvancedTab" GroupName="SettingsTab" Style="{StaticResource LedToggle}" Content="ADVANCED" Margin="2,0,0,0" Checked="Tab_Checked"
                                 ToolTip="Crossfade length and the phone remote" AutomationProperties.Name="Advanced settings" />
                </StackPanel>
                <Border Height="0.5" Background="#4A4F62" Margin="0,5,0,6" />

                <Grid>
                    <StackPanel x:Name="GeneralPage">
                        <CheckBox x:Name="OnTopCheck" Style="{StaticResource SkinCheck}" Content="Keep Fernplay on top of other windows"
                                  Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="SnapCheck" Style="{StaticResource SkinCheck}" Content="Snap panels to each other and the screen edges" Margin="0,6,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="RememberCheck" Style="{StaticResource SkinCheck}" Content="Remember the playlist between runs" Margin="0,6,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed" />
                        <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="10,5,0,0" TextWrapping="Wrap"
                                   Text="Changes apply at once and are saved when Fernplay closes." />

                        <Border Height="0.5" Background="#4A4F62" Margin="0,7,0,6" />
                        <TextBlock Text="VOLUME LEVELLING" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LevelOff" GroupName="Levelling" Style="{StaticResource LedToggle}" Content="OFF" Tag="Off" Checked="Level_Checked"
                                         ToolTip="Play every file as it is" AutomationProperties.Name="Volume levelling off" />
                            <RadioButton x:Name="LevelTrack" GroupName="Levelling" Style="{StaticResource LedToggle}" Content="TRACK" Tag="Track" Margin="2,0,0,0" Checked="Level_Checked"
                                         ToolTip="Every song at the same loudness (ReplayGain track gain)" AutomationProperties.Name="Volume levelling by track" />
                            <RadioButton x:Name="LevelAlbum" GroupName="Levelling" Style="{StaticResource LedToggle}" Content="ALBUM" Tag="Album" Margin="2,0,0,0" Checked="Level_Checked"
                                         ToolTip="Every album at the same loudness, quiet and loud songs within it kept (ReplayGain album gain)" AutomationProperties.Name="Volume levelling by album" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="Uses the ReplayGain tags in MP3, FLAC and M4A files (a tagger such as foobar2000 or MusicBee writes them). Files without tags and stations play 6&#160;dB quieter, to match." />

                        <Border Height="0.5" Background="#4A4F62" Margin="0,7,0,6" />
                        <TextBlock Text="EXPLORER" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" Margin="0,0,0,4" />
                        <CheckBox x:Name="ExplorerCheck" Style="{StaticResource SkinCheck}" Content="Open music and playlists from Explorer"
                                  Checked="Explorer_Changed" Unchecked="Explorer_Changed" />
                        <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="10,3,0,0" TextWrapping="Wrap"
                                   Text="Adds Fernplay to Open with, and Add to Fernplay playlist to the right-click menu. For you only; untick to remove it again." />
                        <Button x:Name="DefaultButton" Style="{StaticResource SkinButton}" Content="MAKE FERNPLAY THE DEFAULT PLAYER…" Height="11" Padding="6,0"
                                Margin="10,5,0,0" HorizontalAlignment="Left" Click="Default_Click"
                                ToolTip="Opens Windows' own page: Windows lets only you choose the default app"
                                AutomationProperties.Name="Make Fernplay the default player" />

                        <Border Height="0.5" Background="#4A4F62" Margin="0,7,0,6" />
                        <TextBlock Text="SKIN" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" Margin="0,0,0,4" />
                        <TextBlock x:Name="SkinText" Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Style="{StaticResource SkinButton}" Content="CHOOSE SKIN…" Height="11" Padding="6,0" Click="ChooseSkin_Click"
                                    ToolTip="A classic skin file (.wsz); it is copied to Fernplay's skins folder"
                                    AutomationProperties.Name="Choose a classic skin" />
                            <Button x:Name="FernplayLookButton" Style="{StaticResource SkinButton}" Content="FERNPLAY LOOK" Height="11" Padding="6,0" Margin="4,0,0,0"
                                    Click="FernplayLook_Click" AutomationProperties.Name="Use Fernplay's own look" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="SIZE" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <RadioButton x:Name="Size1" GroupName="SkinSize" Style="{StaticResource LedToggle}" Content="1X" Tag="1" Checked="Size_Checked"
                                         ToolTip="Classic skins at their own pixel size" AutomationProperties.Name="Skin size 1x" />
                            <RadioButton x:Name="Size2" GroupName="SkinSize" Style="{StaticResource LedToggle}" Content="1.5X" Tag="2" Margin="2,0,0,0" Checked="Size_Checked"
                                         ToolTip="Classic skins at one and a half times their pixel size" AutomationProperties.Name="Skin size 1.5x" />
                            <RadioButton x:Name="Size3" GroupName="SkinSize" Style="{StaticResource LedToggle}" Content="1.75X" Tag="3" Margin="2,0,0,0" Checked="Size_Checked"
                                         ToolTip="Classic skins at one and three quarter times their pixel size, about as big as Fernplay's own look" AutomationProperties.Name="Skin size 1.75x" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedPage" Visibility="Hidden">
                        <TextBlock Text="CROSSFADE" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="XfadeSlider" Style="{StaticResource SkinSliderH}" Minimum="1" Maximum="12" SmallChange="1" LargeChange="1"
                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Xfade_ValueChanged"
                                    AutomationProperties.Name="Crossfade length in seconds" />
                            <TextBlock x:Name="XfadeText" Grid.Column="1" Style="{StaticResource SkinLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="How long one song fades into the next when XFADE is on (app menu: Crossfade). With repeat track the song loops gapless instead. Skipping by hand and stations never fade." />

                        <Border Height="0.5" Background="#4A4F62" Margin="0,7,0,6" />
                        <TextBlock Text="PHONE REMOTE" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" Margin="0,0,0,4" />
                        <CheckBox x:Name="RemoteCheck" Style="{StaticResource SkinCheck}" Content="Let the Fernplay app on your phone control this player"
                                  Checked="Remote_Changed" Unchecked="Remote_Changed" />
                        <TextBlock x:Name="RemoteStatus" Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="10,3,0,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Margin="10,5,0,0">
                            <Button x:Name="PairButton" Style="{StaticResource SkinButton}" Content="PAIR A PHONE…" Height="11" Padding="6,0" Click="Pair_Click"
                                    ToolTip="Shows a code to type into the Fernplay app on your phone" AutomationProperties.Name="Pair a phone" />
                            <TextBlock x:Name="PairCode" Style="{StaticResource LcdText}" FontSize="9" Foreground="{StaticResource Amber}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" AutomationProperties.HelpText="Pairing code" />
                            <TextBlock x:Name="PairTime" Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="5" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl x:Name="PhonesList" Margin="10,4,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SkinButton}" Content="REMOVE" Height="9" Padding="4,0" Tag="{Binding Id}"
                                                Click="RemovePhone_Click" AutomationProperties.Name="{Binding RemoveName}" />
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource SkinLabel}" FontWeight="Normal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <Button Style="{StaticResource SkinButton}" Content="CLOSE" Height="11" Padding="8,0" Margin="0,7,0,0" HorizontalAlignment="Right"
                        IsDefault="True" Click="Close_Click" AutomationProperties.Name="Close settings" />
            </StackPanel>
        </StackPanel>
    </Border>
</local:SkinDialog>
