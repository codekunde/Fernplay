<local:SkinWindow x:Class="Fernplay.App.EqWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay equalizer" ShowInTaskbar="False">
    <Border Width="280" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Background="{StaticResource TitleRibs}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY EQUALIZER" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" Content="x" Click="Close_Click"
                            ToolTip="Hide the equalizer" AutomationProperties.Name="Hide the equalizer" />
                </Border>
            </Grid>

            <!-- On, curve preview, presets -->
            <Grid Margin="6,4,6,0" Height="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="OnToggle" Style="{StaticResource LedToggle}" Content="ON" VerticalAlignment="Top" Checked="On_Changed" Unchecked="On_Changed"
                              ToolTip="Turn the equalizer on or off" AutomationProperties.Name="Equalizer on" />
                <Border Grid.Column="1" Style="{StaticResource Inset}" Width="112" HorizontalAlignment="Center">
                    <local:EqCurve x:Name="Curve" />
                </Border>
                <Button x:Name="PresetsButton" Grid.Column="2" Style="{StaticResource SkinButton}" Content="PRESETS" Height="10" Padding="4,0"
                        VerticalAlignment="Top" Click="Presets_Click" ToolTip="Choose a preset" AutomationProperties.Name="Presets">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PresetsMenu" />
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- Preamp, scale, 10 bands -->
            <Grid Margin="6,4,6,6" Height="66">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="9" />
                </Grid.RowDefinitions>

                <Slider x:Name="PreampSlider" Style="{StaticResource EqSlider}" HorizontalAlignment="Center"
                        ValueChanged="Preamp_ValueChanged" AutomationProperties.Name="Preamp" />
                <TextBlock Grid.Row="1" Text="PRE" Style="{StaticResource SkinLabel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />

                <Grid Grid.Column="1" Margin="0,2">
                    <TextBlock Text="+12 dB" Style="{StaticResource SkinLabel}" FontSize="5" VerticalAlignment="Top" HorizontalAlignment="Center" />
                    <TextBlock Text="0 dB" Style="{StaticResource SkinLabel}" FontSize="5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="-12 dB" Style="{StaticResource SkinLabel}" FontSize="5" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                </Grid>

                <UniformGrid x:Name="BandSliders" Grid.Column="2" Rows="1" />
                <UniformGrid x:Name="BandLabels" Grid.Column="2" Grid.Row="1" Rows="1" />
            </Grid>
        </StackPanel>
    </Border>
</local:SkinWindow>
