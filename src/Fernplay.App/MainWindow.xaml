<local:SkinWindow x:Class="Fernplay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Click" />
    </Window.CommandBindings>

    <Grid>
    <!-- A classic skin (.wsz) is built in code into ClassicHost; FernplayView is hidden meanwhile. -->
    <ContentControl x:Name="ClassicHost" Focusable="False" Visibility="Collapsed" />
    <!-- Skin pixels, scaled by SkinWindow.Scale. -->
    <Border x:Name="FernplayView" Width="280" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <!-- Title bar: drag handle -->
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Background="{StaticResource TitleRibs}">
                <!-- App menu: settings and about (click or right-click). -->
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Left" Padding="1,1">
                    <Button x:Name="AppMenuButton" Width="8" Height="8" Click="AppMenu_Click" Cursor="Hand"
                            FocusVisualStyle="{StaticResource SkinFocus}"
                            ToolTip="Settings and about" AutomationProperties.Name="Fernplay menu">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent"><ContentPresenter /></Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Image x:Name="AppMenuIcon" Width="8" Height="8" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Button.ContextMenu>
                            <ContextMenu x:Name="AppMenu">
                                <MenuItem Header="Media library…" Click="Library_Click" ToolTip="Alt+L" />
                                <MenuItem Header="Settings…" Click="Settings_Click" />
                                <MenuItem Header="About Fernplay" Click="About_Click" />
                                <Separator />
                                <MenuItem Header="Exit" Click="Close_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY" Style="{StaticResource SkinLabel}" Foreground="{StaticResource TitleText}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}" Content="_" Click="Minimize_Click"
                                ToolTip="Minimise" AutomationProperties.Name="Minimise" />
                        <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" Content="x" Click="Close_Click"
                                ToolTip="Close Fernplay" AutomationProperties.Name="Close Fernplay" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Display -->
            <Grid Margin="6,4,6,0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Inset}">
                    <Grid Margin="3,3,4,2">
                        <Path x:Name="StateGlyph" Fill="{StaticResource LcdGreen}" Stretch="Uniform" Width="5" Height="5"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,3,0,0" Data="{StaticResource GlyphStop}" />
                        <Button x:Name="ClockButton" Click="Clock_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                FocusVisualStyle="{StaticResource SkinFocus}" Cursor="Hand"
                                ToolTip="Switch between time played and time left"
                                AutomationProperties.Name="Time: switch between played and left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter /></Border></ControlTemplate>
                            </Button.Template>
                            <local:SevenSegment x:Name="Clock" Text="0:00" />
                        </Button>
                        <local:SpectrumBars x:Name="Spectrum" Height="14" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Inset}" Height="11" Padding="2,0">
                        <local:Marquee x:Name="TitleMarquee" Text="Fernplay  Open music with the eject button or drop it here" />
                    </Border>
                    <Grid Margin="0,4,0,0" Height="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="13" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Inset}">
                            <TextBlock x:Name="KbpsText" Style="{StaticResource LcdText}" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="kbps" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="2,0,5,0" />
                        <Border Grid.Column="2" Style="{StaticResource Inset}">
                            <TextBlock x:Name="KhzText" Style="{StaticResource LcdText}" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,1,0" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="kHz" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <TextBlock x:Name="MonoText" Grid.Column="5" Text="mono" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="StereoText" Grid.Column="6" Text="stereo" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" />
                    </Grid>
                    <!-- Volume and the EQ / playlist switches -->
                    <Grid Margin="0,6,0,0" Height="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VOL" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource SkinSliderH}" Minimum="0" Maximum="100"
                                SmallChange="5" LargeChange="10" Margin="0,0,8,0" ValueChanged="Volume_ValueChanged" PreviewMouseWheel="Volume_MouseWheel"
                                AutomationProperties.Name="Volume">
                            <Slider.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2FB845" Offset="0" />
                                    <GradientStop Color="#E3CF4A" Offset="0.7" />
                                    <GradientStop Color="#E8853A" Offset="1" />
                                </LinearGradientBrush>
                            </Slider.Foreground>
                        </Slider>
                        <!-- Balance: snaps to the centre on a click, a key or when the knob is let go (the classic skin's slider is bound to this one). -->
                        <TextBlock Grid.Column="2" Text="BAL" Style="{StaticResource SkinLabel}" VerticalAlignment="Center" Margin="0,0,3,0" />
                        <Slider x:Name="BalanceSlider" Grid.Column="3" Style="{StaticResource SkinBalanceSlider}" Width="34" Minimum="-100" Maximum="100"
                                SmallChange="10" LargeChange="20" Margin="0,0,8,0" ValueChanged="Balance_ValueChanged" PreviewMouseWheel="Balance_MouseWheel"
                                Thumb.DragStarted="Balance_DragStarted" Thumb.DragCompleted="Balance_DragCompleted" AutomationProperties.Name="Balance" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <ToggleButton x:Name="EqToggle" Style="{StaticResource LedToggle}" Content="EQ" Checked="EqToggle_Changed" Unchecked="EqToggle_Changed"
                                          ToolTip="Show or hide the equalizer" AutomationProperties.Name="Equalizer panel" />
                            <ToggleButton x:Name="PlaylistToggle" Style="{StaticResource LedToggle}" Content="PL" Margin="2,0,0,0" Checked="PlaylistToggle_Changed" Unchecked="PlaylistToggle_Changed"
                                          ToolTip="Show or hide the playlist" AutomationProperties.Name="Playlist panel" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Position -->
            <Slider x:Name="SeekSlider" Style="{StaticResource SkinSliderH}" Margin="6,6,6,0" Minimum="0" Maximum="1" IsEnabled="False"
                    SmallChange="5" LargeChange="30" AutomationProperties.Name="Position in the track"
                    ValueChanged="Seek_ValueChanged" Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" />

            <!-- Transport -->
            <Grid Margin="6,5,6,5" Height="16">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource SkinButton}" Width="21" Click="Prev_Click" ToolTip="Previous track (Z)" AutomationProperties.Name="Previous track" AutomationProperties.AcceleratorKey="Z">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphPrev}" />
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource SkinButton}" Width="21" Click="Play_Click" ToolTip="Play (X; Space plays or pauses)" AutomationProperties.Name="Play" AutomationProperties.AcceleratorKey="X">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphPlay}" />
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource SkinButton}" Width="21" Click="Pause_Click" ToolTip="Pause, again to resume (C)" AutomationProperties.Name="Pause" AutomationProperties.AcceleratorKey="C">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphPause}" />
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource SkinButton}" Width="21" Click="Stop_Click" ToolTip="Stop (V)" AutomationProperties.Name="Stop" AutomationProperties.AcceleratorKey="V">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphStop}" />
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource SkinButton}" Width="21" Click="Next_Click" ToolTip="Next track (B)" AutomationProperties.Name="Next track" AutomationProperties.AcceleratorKey="B">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphNext}" />
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource SkinButton}" Width="18" Height="14" Margin="5,0,0,0" Click="Open_Click"
                            ToolTip="Open music files (Ctrl+O); right-click for a folder" AutomationProperties.Name="Open music files">
                        <Path Style="{StaticResource Glyph}" Data="{StaticResource GlyphOpen}" />
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open files…" Click="Open_Click" />
                                <MenuItem Header="Open folder…" Click="OpenFolder_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ToggleButton x:Name="ShuffleToggle" Style="{StaticResource LedToggle}" Content="SHUFFLE" Margin="6,0,0,0" Checked="Shuffle_Changed" Unchecked="Shuffle_Changed"
                                  ToolTip="Play the list in a random order" AutomationProperties.Name="Shuffle" />
                    <ToggleButton x:Name="RepeatToggle" Style="{StaticResource LedToggle}" Content="REPEAT" Margin="2,0,0,0" Checked="Repeat_Changed" Unchecked="Repeat_Changed"
                                  ToolTip="Repeat: off, whole list, this track" AutomationProperties.Name="Repeat" />
                </StackPanel>
                <!-- Fern mark (Fernplay's own logo) -->
                <Viewbox HorizontalAlignment="Right" Width="13" Height="15" ToolTip="Fernplay">
                    <Canvas Width="14" Height="16">
                        <Path Stroke="#7FBF6E" StrokeThickness="0.8" Data="M6.5,15.5 Q7,8 11,0.8" />
                        <Path Fill="#5FA052" Data="M6.9,13 L2.5,12 L6.8,11.3 Z M7.1,12.6 L11.6,10.6 L7.4,11.2 Z M7.2,10 L3.4,8.4 L7.4,8.6 Z M7.6,9.6 L11.8,7.2 L8,8.2 Z M8.1,6.9 L5,5.2 L8.4,5.6 Z M8.7,6.4 L12,3.9 L9,5.2 Z M9.6,3.9 L7.5,2.3 L9.9,3 Z" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </StackPanel>
    </Border>
    </Grid>
</local:SkinWindow>
