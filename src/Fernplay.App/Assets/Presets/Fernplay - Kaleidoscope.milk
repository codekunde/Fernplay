wave_0_per_point1=c = min(floor(sample*12), 11); u = sample*12 - c; dir = c - 2*floor(c/2); uu = if(dir, 1 - u, u); k = floor(c/2); sg = 1 - 2*dir;
wave_0_per_point2=rr = 0.015 + 0.25*uu; phi = (0.28 + 0.12*q1)*sin(uu*(4 + 2*q2) + time*0.45)*uu;
wave_0_per_point3=th = k*1.0472 + sg*phi + time*0.05; x = 0.5 + rr*cos(th); y = 0.5 + rr*sin(th);
wave_0_per_point4=hue = uu*2.5 + q4; r = 0.55 + 0.45*sin(hue); g = 0.55 + 0.45*sin(hue + 2.094); b = 0.55 + 0.45*sin(hue + 4.189); a = 0.75;
