wave_1_per_point1=c = min(floor(sample*12), 11); u = sample*12 - c; dir = c - 2*floor(c/2); uu = if(dir, 1 - u, u); k = floor(c/2); sg = 1 - 2*dir;
wave_1_per_point2=rr = 0.04 + 0.17*uu; phi = (0.45 + 0.1*q2)*sin(uu*3 - time*0.3)*(1 - uu*0.5);
wave_1_per_point3=th = k*1.0472 + 0.5236 + sg*phi - time*0.03; x = 0.5 + rr*cos(th); y = 0.5 + rr*sin(th);
wave_1_per_point4=hue = uu*2 + q4 + 3.1416; r = 0.6 + 0.4*sin(hue); g = 0.6 + 0.4*sin(hue + 2.094); b = 0.6 + 0.4*sin(hue + 4.189); a = 0.65;
wave_1_per_point5=y = 1 - y;
