shape_0_per_frame1=k = instance - 4*floor(instance/4);
shape_0_per_frame2=x = 0.5 + 0.38*sin(time*(0.071 + instance*0.013) + instance*2.1);
shape_0_per_frame3=y = 0.5 + 0.36*sin(time*(0.053 + instance*0.011) + instance*1.3 + 1);
shape_0_per_frame4=rad = (0.45 + 0.08*sin(time*0.2 + instance))*(1 + 0.12*q1);
shape_0_per_frame5=k0 = equal(k, 0); k1 = equal(k, 1); k2 = equal(k, 2); k3 = equal(k, 3);
shape_0_per_frame6=r = 0.30*k0 + 0.91*k1 + 0.16*k2 + 0.10*k3; g = 0.70*k0 + 0.72*k1 + 0.58*k2 + 0.14*k3; b = 0.32*k0 + 0.26*k1 + 0.60*k2 + 0.36*k3;
shape_0_per_frame7=r2 = r; g2 = g; b2 = b; a = 0.05; a2 = 0;
shape_0_per_frame8=y = 1 - y;
per_frame_init_1=sb = 0;
per_frame_1=wave_a = 0;
per_frame_2=sb = sb*0.96 + 0.04*min(bass_att, 2); q1 = sb;
per_frame_3=decay = 0.995;
per_pixel_1=dx = (0.0025 + 0.001*q1)*sin(y*7.0 + time*0.31);
per_pixel_2=dy = (0.0025 + 0.001*q1)*sin(x*6.0 - time*0.27);
per_pixel_3=rot = 0.006*sin(rad*9.0 - time*0.2);
per_pixel_4=zoom = 1.0 + 0.004*sin(ang*3 + time*0.15);
