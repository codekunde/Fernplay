shape_0_per_frame1=a = 0.035 + 0.015*q1; rad = 0.9; r = 0.22 + 0.06*sin(time*0.05); g = 0.28; b = 0.55 + 0.08*sin(time*0.07);
shape_0_per_frame2=y = 1 - y;
