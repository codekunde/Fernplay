wave_0_per_point1=i = floor(sample*399 + 0.5); o = i*4;
wave_0_per_point2=sx0 = megabuf(o); sy0 = megabuf(o + 1); sz = megabuf(o + 2); am = megabuf(o + 3);
wave_0_per_point3=fresh = below(sz, 0.03);
wave_0_per_point4=sa = rand(6283)/1000; sr = 0.3 + rand(700)/1000;
wave_0_per_point5=sx0 = if(fresh, sr*cos(sa), sx0); sy0 = if(fresh, sr*sin(sa)*0.75, sy0);
wave_0_per_point6=sz = if(fresh, 0.4 + rand(1600)/1000, sz); am = if(fresh, below(rand(100), 12), am);
wave_0_per_point7=sz = sz - q2;
wave_0_per_point8=x = 0.5 + sx0/max(sz, 0.03)*0.08; y = 0.5 + sy0/max(sz, 0.03)*0.08;
wave_0_per_point9=sz = if(above(abs(x - 0.5), 0.52) + above(abs(y - 0.5), 0.34), 0, sz);
wave_0_per_point10=megabuf(o) = sx0; megabuf(o + 1) = sy0; megabuf(o + 2) = sz; megabuf(o + 3) = am;
wave_0_per_point11=r = 0.82 + 0.13*am; g = 0.87 - 0.12*am; b = 1.0 - 0.62*am;
wave_0_per_point12=a = max(0, min(1, 0.4/max(sz, 0.05) - 0.4));
wave_0_per_point13=y = 1 - y;
