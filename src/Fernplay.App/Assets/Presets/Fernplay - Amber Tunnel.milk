shape_0_per_frame1=u = q2 + instance/10; id = instance + 10*floor(u); u = u - floor(u);
shape_0_per_frame2=k = id - 2*floor(id/2);
shape_0_per_frame3=rad = 0.02*pow(110, u); x = 0.5; y = 0.5; ang = time*0.15 + u*1.4;
shape_0_per_frame4=border_r = 0.91 - 0.49*k; border_g = 0.77 - 0.02*k; border_b = 0.28 + 0.07*k;
shape_0_per_frame5=border_a = min(1, u*5)*(0.75 + 0.25*q1);
shape_0_per_frame6=r = border_r; g = border_g; b = border_b; r2 = 0; g2 = 0; b2 = 0; a = 0.05*min(1, u*5); a2 = 0;
shape_0_per_frame7=y = 1 - y;
