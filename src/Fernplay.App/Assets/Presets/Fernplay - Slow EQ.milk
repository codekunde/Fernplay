wave_0_per_point1=k = min(floor(16*sqrt(sample)), 15);
wave_0_per_point2=gmegabuf(100+k) = gmegabuf(100+k) + abs(value1) + abs(value2);
wave_0_per_point3=gmegabuf(120+k) = gmegabuf(120+k) + 2;
