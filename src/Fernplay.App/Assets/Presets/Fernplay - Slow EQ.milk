shape_1_per_frame1=bd = floor(instance/12); s = instance - bd*12; f = equal(s, 0);
shape_1_per_frame2=raw = gmegabuf(100+bd)/max(1, gmegabuf(120+bd));
shape_1_per_frame3=pk = max(raw, gmegabuf(160+bd)*0.996); gmegabuf(160+bd) = f*pk + (1-f)*gmegabuf(160+bd);
shape_1_per_frame4=norm = min(1, raw/max(0.8*pk, 0.000001)); norm = norm*sqrt(norm);
shape_1_per_frame5=idle = 0.10 + 0.07*sin(time*0.9 - bd*0.45);
shape_1_per_frame6=target = max(norm*0.92, idle);
shape_1_per_frame7=lv = gmegabuf(140+bd); lv = if(above(target, lv), lv + (target - lv)*0.12, max(target, lv - 0.0055));
shape_1_per_frame8=gmegabuf(140+bd) = f*lv + (1-f)*gmegabuf(140+bd);
shape_1_per_frame9=pc = gmegabuf(180+bd); pc = if(above(lv, pc), lv, pc - 0.0025); gmegabuf(180+bd) = f*pc + (1-f)*gmegabuf(180+bd);
shape_1_per_frame10=gmegabuf(100+bd) = (1-f)*gmegabuf(100+bd); gmegabuf(120+bd) = (1-f)*gmegabuf(120+bd);
shape_1_per_frame11=L = gmegabuf(140+bd); P = gmegabuf(180+bd);
shape_1_per_frame12=lit = below((s + 0.5)/12, L); cap = equal(s, min(11, floor(P*12)))*(1 - lit);
shape_1_per_frame13=t = s/11;
shape_1_per_frame14=r = 0.38 + 0.55*t; g = 0.74 + 0.04*t - 0.12*t*t; b = 0.33 - 0.08*t;
shape_1_per_frame15=r = r + cap*0.1; g = g + cap*0.05;
shape_1_per_frame16=a = min(0.95, 0.03 + 0.87*lit + 0.75*cap);
shape_1_per_frame17=r2 = r*0.8; g2 = g*0.8; b2 = b*0.8; a2 = a*0.75;
shape_1_per_frame18=x = 0.12 + (bd + 0.5)*0.0475; y = 0.865 - s*0.055;
shape_1_per_frame19=y = 1 - y;
per_frame_1=wave_a = 0;
per_frame_2=dy = -0.0009; zoom = 1; decay = 0.80;
