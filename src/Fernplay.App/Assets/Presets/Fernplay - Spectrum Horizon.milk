wave_0_per_point1=wt = above(sample, 0.004); k = min(floor(24*sqrt(max(0, sample - 0.004)/0.996)), 23);
wave_0_per_point2=gmegabuf(200+k) = gmegabuf(200+k) + wt*(abs(value1) + abs(value2));
wave_0_per_point3=gmegabuf(230+k) = gmegabuf(230+k) + 2*wt;
wave_0_per_point4=x = -0.5; y = 0.5; a = 0;
wave_0_per_point5=y = 1 - y;
