wavecode_1_g=1.000000
wavecode_1_b=1.000000
wavecode_1_a=0.000000
wave_1_per_point1=bd = min(floor(sample*23 + 0.5), 23);
wave_1_per_point2=raw = gmegabuf(200+bd)/max(1, gmegabuf(230+bd)); gmegabuf(200+bd) = 0; gmegabuf(230+bd) = 0;
wave_1_per_point3=pk = max(raw, gmegabuf(260+bd)*0.996); gmegabuf(260+bd) = pk;
wave_1_per_point4=n = min(1, raw/max(0.75*pk, 0.000001));
wave_1_per_point5=idle = 0.08 + 0.05*sin(time*0.7 + bd*0.5);
wave_1_per_point6=tg = max(n*0.9, idle);
wave_1_per_point7=lv = gmegabuf(290+bd); lv = if(above(tg, lv), lv + (tg - lv)*0.10, max(tg, lv - 0.004)); gmegabuf(290+bd) = lv;
wave_1_per_point8=x = -0.5; y = 0.5; a = 0;
wave_1_per_point9=y = 1 - y;
wavecode_2_enabled=1
