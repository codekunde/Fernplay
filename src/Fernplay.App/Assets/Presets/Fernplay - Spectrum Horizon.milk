wavecode_3_a=1.000000
wave_3_per_point1=p = abs(sample - 0.5)*2*23; b0 = min(floor(p), 22); fr = p - b0; sm = fr*fr*(3 - 2*fr);
wave_3_per_point2=v = gmegabuf(290+b0)*(1 - sm) + gmegabuf(291+b0)*sm;
wave_3_per_point3=x = 0.04 + sample*0.92; y = 0.5 + 0.006 + v*0.20;
wave_3_per_point4=r = 0.30 + 0.1*v; g = 0.72; b = 0.36; a = 0.25 + 0.5*v;
