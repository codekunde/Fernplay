wavecode_2_smoothing=0.000000
wavecode_2_r=1.000000
wavecode_2_g=1.000000
wavecode_2_b=1.000000
wavecode_2_a=1.000000
wave_2_per_point1=p = abs(sample - 0.5)*2*23; b0 = min(floor(p), 22); fr = p - b0; sm = fr*fr*(3 - 2*fr);
wave_2_per_point2=v = gmegabuf(290+b0)*(1 - sm) + gmegabuf(291+b0)*sm;
wave_2_per_point3=x = 0.04 + sample*0.92; y = 0.5 - 0.006 - v*0.20;
wave_2_per_point4=r = 0.91; g = 0.66 + 0.11*v; b = 0.22 + 0.06*v; a = 0.25 + 0.5*v;
wave_2_per_point5=y = 1 - y;
