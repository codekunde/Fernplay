shape_2_per_frame1=c = floor(instance/12);
shape_2_per_frame2=h1 = sin(c*12.9898 + 1.1)*43758.5453; h1 = h1 - floor(h1);
shape_2_per_frame3=h2 = sin(c*78.233 + 2.7)*24634.6345; h2 = h2 - floor(h2);
shape_2_per_frame4=h3 = sin(c*39.425 + 5.3)*15731.7431; h3 = h3 - floor(h3);
shape_2_per_frame5=j1 = sin(instance*17.13 + 0.7)*31337.731; j1 = j1 - floor(j1);
shape_2_per_frame6=j2 = sin(instance*63.71 + 1.9)*21789.112; j2 = j2 - floor(j2);
shape_2_per_frame7=j3 = sin(instance*27.91 + 4.4)*11213.997; j3 = j3 - floor(j3);
shape_2_per_frame8=speed = 0.006 + 0.004*h3;
shape_2_per_frame9=px = c/6 + 0.08*h1 + time*speed; px = px - floor(px);
shape_2_per_frame10=cx0 = px*1.7 - 0.35; cy0 = 0.22 + 0.46*h2 + 0.012*sin(time*0.13 + c*2);
shape_2_per_frame11=w = 0.12 + 0.08*h3;
shape_2_per_frame12=u = j1*2 - 1; dome = 1 - u*u;
shape_2_per_frame13=x = cx0 + u*w; y = cy0 - j2*0.11*dome;
shape_2_per_frame14=rad = (0.13 + 0.13*j3)*(0.55 + 0.45*dome)*(1 + 0.05*q1);
shape_2_per_frame15=shade = min(1, max(0, (y - cy0 + 0.11)/0.13));
shape_2_per_frame16=r = 1 - 0.10*shade; g = 1 - 0.08*shade; b = 1 - 0.03*shade;
shape_2_per_frame17=r2 = 0.80; g2 = 0.85; b2 = 0.93;
shape_2_per_frame18=a = (0.22 + 0.08*j3)*(1 + 0.2*q1); a2 = 0;
shape_2_per_frame19=y = 1 - y;
per_frame_init_1=sb = 0; sm = 0;
per_frame_1=wave_a = 0;
per_frame_2=sb = sb*0.97 + 0.03*min(bass_att, 2);
per_frame_3=sm = sm*0.985 + 0.015*min(mid_att, 2);
per_frame_4=q1 = sb; q2 = sm;
per_frame_5=dx = -0.00028; dy = 0;
per_frame_6=warp = 0.03 + 0.03*sm;
per_frame_7=decay = 1;
