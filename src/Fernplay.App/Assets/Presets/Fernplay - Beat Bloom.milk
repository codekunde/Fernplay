shape_0_per_frame4=rad = 0.05 + 0.05*q1;
shape_0_per_frame5=hue = q2 + instance*0.25; k = hue - 4*floor(hue/4); k0 = below(k, 1); k1 = below(k, 2)*(1 - k0); k2 = below(k, 3)*(1 - k0 - k1); k3 = 1 - k0 - k1 - k2;
shape_0_per_frame6=r = 0.38*k0 + 0.91*k1 + 0.25*k2 + 0.86*k3; g = 0.74*k0 + 0.72*k1 + 0.70*k2 + 0.40*k3; b = 0.33*k0 + 0.25*k1 + 0.72*k2 + 0.52*k3;
shape_0_per_frame7=r2 = r; g2 = g; b2 = b; a = 0.40 + 0.45*q1; a2 = 0;
