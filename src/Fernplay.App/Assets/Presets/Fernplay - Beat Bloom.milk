per_frame_init_1=env = 0; last = 0; hue = 0; spin = 1; turn = 0;
per_frame_1=wave_a = 0;
per_frame_2=beat = above(bass, 1.22*max(bass_att, 0.25))*above(time - last, 0.38);
per_frame_3=last = if(beat, time, last);
per_frame_4=env = max(env*0.91, beat);
per_frame_5=hue = hue + beat; spin = if(beat, -spin, spin);
per_frame_6=turn = turn + 0.004 + 0.03*env*spin;
per_frame_7=q1 = max(env, 0.30 + 0.15*sin(time*0.9)); q2 = hue + 0.05*time; q3 = turn;
per_frame_8=zoom = 1.0 + 0.045*env; rot = 0.025*env*spin; decay = 0.86;
