<local:SkinDialog x:Class="Fernplay.App.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fernplay.App"
        Title="Fernplay file info">
    <local:SkinDialog.Resources>
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="{StaticResource SkinFont}" />
            <Setter Property="FontSize" Value="6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource SkinTextDim}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:SkinDialog.Resources>
    <Border Width="250" Background="{StaticResource PanelBrush}" BorderBrush="#5A5F72" BorderThickness="0.5">
        <Border.LayoutTransform><ScaleTransform ScaleX="{x:Static local:SkinWindow.Scale}" ScaleY="{x:Static local:SkinWindow.Scale}" /></Border.LayoutTransform>
        <StackPanel>
            <Grid x:Name="TitleBar" Height="10" Margin="2,2,2,0" Style="{StaticResource TitleBar}">
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Center" Padding="5,0">
                    <TextBlock Text="FERNPLAY FILE INFO" Style="{StaticResource TitleLabel}" VerticalAlignment="Center" />
                </Border>
                <Border Background="{StaticResource FrameDark}" HorizontalAlignment="Right" Padding="1,1">
                    <Button Style="{StaticResource TitleButton}" Content="x" Click="Close_Click" ToolTip="Close without saving" AutomationProperties.Name="Close without saving" />
                </Border>
            </Grid>

            <StackPanel Margin="8,7,8,7">
                <!-- The file: name, folder, what it is. -->
                <Border Style="{StaticResource Inset}" Padding="3,2">
                    <StackPanel>
                        <TextBlock x:Name="FileNameText" Style="{StaticResource LcdText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FolderText" Style="{StaticResource LcdText}" FontSize="6" Foreground="#2E9A4A" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock x:Name="FormatText" Style="{StaticResource LcdText}" FontSize="6" Foreground="#2E9A4A" Margin="0,1,0,0" />
                    </StackPanel>
                </Border>

                <Grid x:Name="FieldGrid" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Style="{StaticResource FieldLabel}" Content="_TITLE" Target="{Binding ElementName=TitleBox}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Style="{StaticResource SkinTextBox}" AutomationProperties.Name="Title" />

                    <Label Grid.Row="1" Style="{StaticResource FieldLabel}" Content="_ARTIST" Target="{Binding ElementName=ArtistBox}" Margin="0,3,0,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ArtistBox" Style="{StaticResource SkinTextBox}" Margin="0,3,0,0"
                             AutomationProperties.Name="Artist" ToolTip="Several artists: separate them with a semicolon (A; B)" />

                    <Label Grid.Row="2" Style="{StaticResource FieldLabel}" Content="AL_BUM" Target="{Binding ElementName=AlbumBox}" Margin="0,3,0,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="AlbumBox" Style="{StaticResource SkinTextBox}" Margin="0,3,0,0" AutomationProperties.Name="Album" />

                    <Label Grid.Row="3" Style="{StaticResource FieldLabel}" Content="ALBUM A_RTIST" Target="{Binding ElementName=AlbumArtistBox}" Margin="0,3,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="AlbumArtistBox" Style="{StaticResource SkinTextBox}" Margin="0,3,0,0" AutomationProperties.Name="Album artist" />

                    <Label Grid.Row="4" Style="{StaticResource FieldLabel}" Content="TRAC_K" Target="{Binding ElementName=TrackBox}" Margin="0,3,0,0" />
                    <Grid Grid.Row="4" Grid.Column="1" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TrackBox" Style="{StaticResource SkinTextBox}" MaxLength="3" AutomationProperties.Name="Track number" />
                        <Label Grid.Column="2" Style="{StaticResource FieldLabel}" Content="_YEAR" Target="{Binding ElementName=YearBox}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        <TextBox Grid.Column="3" x:Name="YearBox" Style="{StaticResource SkinTextBox}" MaxLength="4" AutomationProperties.Name="Year" />
                    </Grid>

                    <Label Grid.Row="5" Style="{StaticResource FieldLabel}" Content="_GENRE" Target="{Binding ElementName=GenreBox}" Margin="0,3,0,0" />
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="GenreBox" Style="{StaticResource SkinTextBox}" Margin="0,3,0,0" AutomationProperties.Name="Genre" />

                    <Label Grid.Row="6" Style="{StaticResource FieldLabel}" Content="_COMPOSER" Target="{Binding ElementName=ComposerBox}" Margin="0,3,0,0" />
                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="ComposerBox" Style="{StaticResource SkinTextBox}" Margin="0,3,0,0" AutomationProperties.Name="Composer" />

                    <Label Grid.Row="7" Style="{StaticResource FieldLabel}" Content="CO_MMENT" Target="{Binding ElementName=CommentBox}" Margin="0,3,0,0" VerticalAlignment="Top" />
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="CommentBox" Style="{StaticResource SkinTextBox}" Margin="0,3,0,0" Height="27"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Comment" />
                </Grid>

                <!-- What went wrong, or what will happen. -->
                <TextBlock x:Name="MessageText" Style="{StaticResource SkinLabel}" FontWeight="Normal" FontSize="6" Foreground="{StaticResource Amber}"
                           TextWrapping="Wrap" Margin="54,5,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

                <Grid Margin="0,7,0,0">
                    <Button x:Name="ExplorerButton" Style="{StaticResource SkinButton}" Content="SHOW IN EXPLORER" Height="11" Padding="6,0" HorizontalAlignment="Left"
                            Click="Explorer_Click" ToolTip="Open the folder with this file selected" AutomationProperties.Name="Show in Explorer" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SaveButton" Style="{StaticResource SkinButton}" Content="SAVE" Height="11" Padding="10,0" IsDefault="True"
                                Click="Save_Click" ToolTip="Write the changes into the file (Enter)" AutomationProperties.Name="Save tags" />
                        <Button Style="{StaticResource SkinButton}" Content="CANCEL" Height="11" Padding="6,0" Margin="4,0,0,0" IsCancel="True"
                                Click="Close_Click" ToolTip="Close without saving (Esc)" AutomationProperties.Name="Cancel" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</local:SkinDialog>
